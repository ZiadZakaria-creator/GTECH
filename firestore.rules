rules_version = '2';

// قواعد أمان قاعدة البيانات (Firestore) لمتجر GTECH
// - العميل يقدر يبعت طلب ويتابع طلباته هو بس (صفحة طلباتي)، ومايقدرش يشوف طلبات حد تاني
// - صاحب المتجر (الأدمن) بس يقدر يشوف الطلبات ويغيّر حالتها
// الأدمن = أي حساب ليه مستند في مجموعة admins برقم الـ UID بتاعه
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /orders/{orderId} {
      // العميل لازم يكون له حساب Firebase (Google أو مجهول) والطلب مربوط بيه
      allow create: if request.auth != null
        && request.resource.data.customer.uid == request.auth.uid
        // رقم الطلب لازم يكون نفس الرقم اللي اتأكد بكود SMS
        && request.auth.token.get("phone_number", "") == "+2" + request.resource.data.customer.phone
        && request.resource.data.status == "new"
        && request.resource.data.id == orderId
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.matches("^01[0125][0-9]{8}$")
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totals.total is number;

      // الأدمن يشوف كل الطلبات، والعميل يشوف طلباته هو بس
      allow read: if isAdmin()
        || (request.auth != null && resource.data.customer.uid == request.auth.uid);

      // الأدمن يغيّر الحالة بس، من غير ما يعدّل بيانات العميل أو الأسعار
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);

      allow delete: if false;
    }

    // المنتجات وصورها: أي حد يشوفها، والأدمن بس يضيف ويعدّل ويحذف
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // بيتضاف من Firebase Console بس
    }
  }
}
