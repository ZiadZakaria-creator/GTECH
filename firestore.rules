rules_version = '2';

// قواعد أمان قاعدة البيانات (Firestore) لمتجر GTECH
// - العميل يقدر يبعت طلب ويتابع طلباته هو بس (صفحة طلباتي)، ومايقدرش يشوف طلبات حد تاني
// - صاحب المتجر (الأدمن) بس يقدر يشوف الطلبات ويغيّر حالتها
// الأدمن = أي حساب ليه مستند في مجموعة admins برقم الـ UID بتاعه
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /orders/{orderId} {
      // العميل لازم يكون له حساب Firebase (Google أو مجهول) والطلب مربوط بيه
      allow create: if request.auth != null
        && request.resource.data.customer.uid == request.auth.uid
        && request.resource.data.status == "new"
        && request.resource.data.id == orderId
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.matches("^01[0125][0-9]{8}$")
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totals.total is number;

      // الأدمن يشوف كل الطلبات، والعميل يشوف طلباته هو بس
      allow read: if isAdmin()
        || (request.auth != null && resource.data.customer.uid == request.auth.uid);

      // الأدمن يغيّر الحالة ورقم التتبع بس، من غير ما يعدّل بيانات العميل أو الأسعار
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt", "shipment", "payment"]);

      allow delete: if false;
    }

    // المنتجات وصورها: أي حد يشوفها، والأدمن بس يضيف ويعدّل ويحذف
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /productImages/{imageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // عدّاد رسايل SMS اليومي: أي حد يزوّده بواحد بس، والأدمن بس يشوفه
    match /smsStats/{day} {
      allow read: if isAdmin();
      allow create: if day.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.keys().hasOnly(["sent", "quotaHits"])
        && request.resource.data.get("sent", 0) <= 1
        && request.resource.data.get("quotaHits", 0) <= 1;
      allow update: if request.resource.data.keys().hasOnly(["sent", "quotaHits"])
        && request.resource.data.get("sent", 0) - resource.data.get("sent", 0) in [0, 1]
        && request.resource.data.get("quotaHits", 0) - resource.data.get("quotaHits", 0) in [0, 1];
    }

    // "نبّهني لما يرجع / لما السعر يقل": العميل يسجّل تنبيه، والأدمن بس يشوفه ويمسحه بعد ما يبعت الإيميل
    match /alerts/{alertId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["productId", "productName", "email", "name", "type", "price", "createdAt"])
        && request.resource.data.type in ["stock", "price"]
        && request.resource.data.productId is number
        && request.resource.data.price is number
        && request.resource.data.email is string
        && request.resource.data.email.size() < 120
        && request.resource.data.email.matches("^[^@ ]+@[^@ ]+[.][^@ ]+$")
        && request.resource.data.productName is string
        && request.resource.data.productName.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60;
      allow read, delete: if isAdmin();
    }

    // السلات المتروكة: كل عميل يكتب سلته هو بس، والأدمن يشوفها ويبعت تذكير
    match /carts/{uid} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 50
        && request.resource.data.email is string
        && request.resource.data.email.size() < 120;
      allow delete: if isAdmin() || (request.auth != null && request.auth.uid == uid);
      // الأدمن يعلّم إن التذكير اتبعت بس
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["remindedAt"]);
    }

    // أرقام العملاء من نافذة "خصم أول أوردر": أي زائر يسيب رقمه بس (من غير ما يقرا حاجة)، والأدمن بس يشوفها
    match /leads/{id} {
      allow create: if request.resource.data.keys().hasOnly(["phone", "createdAt", "page", "source"])
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^01[0125][0-9]{8}$')
        && request.resource.data.createdAt is string && request.resource.data.createdAt.size() < 40
        && request.resource.data.page is string && request.resource.data.page.size() <= 80
        && request.resource.data.source is string && request.resource.data.source.size() < 30;
      allow read, delete: if isAdmin();
    }

    // صاحبك عليا: عدد مكافآت كل كود. أي حد يقرا كوده (رقم بس)، والأدمن بس يزوّد ويخصم
    match /rewards/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // عدّاد الزوار: أي حد يزوّد بواحد بس، والأدمن بس يشوف الأرقام
    // (مصدر الزيارة src_*، ومسار الشراء: viewers شافوا منتج، carts ضافوا للسلة، checkouts دخلوا الدفع)
    function visitNew(f) { return request.resource.data.get(f, 0) <= 1; }
    function visitInc(f) { return request.resource.data.get(f, 0) - resource.data.get(f, 0) in [0, 1]; }
    match /visits/{day} {
      allow read: if isAdmin();
      allow create: if day.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.keys().hasOnly(["visitors", "newVisitors", "mobile", "desktop", "viewers", "carts", "checkouts", "src_facebook", "src_instagram", "src_tiktok", "src_google", "src_whatsapp", "src_direct", "src_other"])
        && visitNew("visitors")
        && visitNew("newVisitors")
        && visitNew("mobile")
        && visitNew("desktop")
        && visitNew("viewers")
        && visitNew("carts")
        && visitNew("checkouts")
        && visitNew("src_facebook")
        && visitNew("src_instagram")
        && visitNew("src_tiktok")
        && visitNew("src_google")
        && visitNew("src_whatsapp")
        && visitNew("src_direct")
        && visitNew("src_other");
      allow update: if request.resource.data.keys().hasOnly(["visitors", "newVisitors", "mobile", "desktop", "viewers", "carts", "checkouts", "src_facebook", "src_instagram", "src_tiktok", "src_google", "src_whatsapp", "src_direct", "src_other"])
        && visitInc("visitors")
        && visitInc("newVisitors")
        && visitInc("mobile")
        && visitInc("desktop")
        && visitInc("viewers")
        && visitInc("carts")
        && visitInc("checkouts")
        && visitInc("src_facebook")
        && visitInc("src_instagram")
        && visitInc("src_tiktok")
        && visitInc("src_google")
        && visitInc("src_whatsapp")
        && visitInc("src_direct")
        && visitInc("src_other");
    }

    // مشاهدات كل منتج في اليوم (للمنتجات الأكتر مشاهدة)
    match /productViews/{viewId} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(["day", "productId", "count"])
        && request.resource.data.day is string
        && request.resource.data.day.matches("^[0-9]{4}-[0-9]{2}-[0-9]{2}$")
        && request.resource.data.productId is int
        && viewId == request.resource.data.day + "_" + string(request.resource.data.productId)
        && request.resource.data.count == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(["count"])
        && request.resource.data.count == resource.data.count + 1;
    }

    // تقييمات العملاء: أي حد يشوفها، وكل عميل يكتب/يعدّل تقييمه هو بس (تقييم واحد لكل منتج)،
    // والأدمن يقدر يمسح أي تقييم
    match /reviews/{reviewId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && reviewId == string(request.resource.data.productId) + "_" + request.auth.uid
        && request.resource.data.keys().hasOnly(["productId", "uid", "name", "stars", "text", "createdAt", "updatedAt"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.productId is int
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 500
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60;
      allow delete: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
    }

    // أسعار الشحن: أي حد يشوفها (صفحة الدفع)، والأدمن بس يعدّلها
    match /settings/shipping {
      allow read: if true;
      allow write: if isAdmin();
    }

    // بيانات الدفع بالتحويل (إنستاباي / فودافون كاش): أي حد يشوفها، والأدمن بس يعدّلها
    match /settings/payment {
      allow read: if true;
      allow write: if isAdmin();
    }

    // صورة التحويل: صاحب الطلب بس يرفعها (صورة واحدة لكل طلب يقدر يغيّرها)، والأدمن بس يشوفها
    match /paymentProofs/{orderId} {
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.customer.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(["data", "createdAt", "uid"])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000;
      allow read, delete: if isAdmin();
    }

    // مفتاح بوسطة: الأدمن بس يشوفه ويعدّله
    match /settings/bosta {
      allow read, write: if isAdmin();
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // بيتضاف من Firebase Console بس
    }
  }
}
