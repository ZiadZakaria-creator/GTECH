rules_version = '2';

// قواعد أمان قاعدة البيانات (Firestore) لمتجر GTECH
// - أي زائر يقدر "يبعت" طلب جديد بس، ومايقدرش يقرا طلبات حد تاني
// - صاحب المتجر (الأدمن) بس يقدر يشوف الطلبات ويغيّر حالتها
// الأدمن = أي حساب ليه مستند في مجموعة admins برقم الـ UID بتاعه
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /orders/{orderId} {
      allow create: if request.resource.data.status == "new"
        && request.resource.data.id == orderId
        && request.resource.data.customer.phone is string
        && request.resource.data.customer.phone.matches("^01[0125][0-9]{8}$")
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.totals.total is number;

      allow read: if isAdmin();

      // الأدمن يغيّر الحالة بس، من غير ما يعدّل بيانات العميل أو الأسعار
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "updatedAt"]);

      allow delete: if false;
    }

    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // بيتضاف من Firebase Console بس
    }
  }
}
